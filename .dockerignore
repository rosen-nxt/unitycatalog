.git
.opencode
.aven-dispatch
**/target
**/node_modules
**/.env.local
**/.env.*.local
**/*.log

# Generated authentication material belongs to the runtime, never the image.
etc/conf/private_key.*
etc/conf/public_key.*
etc/conf/key_id.txt
etc/conf/certs.json
etc/conf/token.txt
etc/conf/server.properties.local
# Runtime database and table files must never be copied into the image.
etc/db/*
etc/data/**
