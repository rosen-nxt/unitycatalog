# Copy to .env.local. CRA reads these values at dev-server/build startup.
# All REACT_APP_* values are public browser configuration. Never add a client secret.
REACT_APP_GOOGLE_AUTH_ENABLED=false
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_OKTA_AUTH_ENABLED=false
REACT_APP_OKTA_DOMAIN=
REACT_APP_OKTA_CLIENT_ID=
REACT_APP_KEYCLOAK_AUTH_ENABLED=false
REACT_APP_KEYCLOAK_URL=
REACT_APP_KEYCLOAK_REALM_ID=
REACT_APP_KEYCLOAK_CLIENT_ID=

REACT_APP_OIDC_AUTH_ENABLED=false
REACT_APP_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
REACT_APP_OIDC_CLIENT_ID=<spa-client-id>
REACT_APP_OIDC_REDIRECT_URI=http://localhost:3000/login/callback
REACT_APP_OIDC_SCOPES=openid profile email
REACT_APP_OIDC_PROVIDER_NAME=Microsoft

# For local HTTPS, supply trusted certificate files in .env.local:
# HTTPS=true
# SSL_CRT_FILE=/absolute/path/to/localhost.pem
# SSL_KEY_FILE=/absolute/path/to/localhost-key.pem
